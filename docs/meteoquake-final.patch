+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { Worker } from "node:worker_threads";
+import { computeShakeTestValues, prepareShakeTest } from "../src/engines/shakeTestSimulation";
+import { AnalysisPipeline, type AnalysisTickInput } from "../src/analysis/analysisPipeline";
+import { AnalysisClient, type AnalysisTransport } from "../src/analysis/analysisClient";
+import { attachWorkerHandler, type WorkerPort } from "../src/analysis/workerHandler";
+import type { FromWorkerMessage, ToWorkerMessage } from "../src/analysis/analysisProtocol";
+import { stationGrid, T0 } from "./helpers";
+
+const stations = stationGrid(38, 142, 9, 0.12); // 361観測点
+const per = prepareShakeTest({ lat: 38.0, lon: 142.0, magnitude: 6.3, depth: 20 }, stations);
+function valuesAt(sec: number): Map<number, number> {
+  const sim = computeShakeTestValues(per, sec * 1000);
+  const m = new Map<number, number>();
+  for (const s of stations) m.set(s.id, sim.has(s.id) ? sim.get(s.id) : -3);
+  return m;
+}
+function inputAt(k: number, values = valuesAt(k)): AnalysisTickInput {
+  return {
+    values, now: T0 + k * 1000, sourceMode: "live", replayClock: false,
+    shakeDetectionEnabled: true, gridDetectionEnabled: false, epicenterEstimationEnabled: true,
+  };
+}
+function ser(x: unknown): string {
+  return JSON.stringify(x, (_k, v) => {
+    if (v instanceof Map) return { __map: [...v] };
+    if (v instanceof Set) return { __set: [...v] };
+    if (typeof v === "number" && !Number.isFinite(v)) return `__${v}`;
+    return v;
+  });
+}
+
+// 実際のスレッド(worker_threads)で動かすトランスポート。
+function spawnThread(): { transport: AnalysisTransport; worker: Worker } {
+  const worker = new Worker(new URL("../tools/analysisNodeWorker.mts", import.meta.url));
+  const transport: AnalysisTransport = {
+    postMessage: (m) => worker.postMessage(m),
+    onmessage: null,
+    terminate: () => { void worker.terminate(); },
+  };
+  worker.on("message", (data: FromWorkerMessage) => transport.onmessage?.({ data }));
+  return { transport, worker };
+}
+
+// 同じプロセス内で、構造化複製(postMessageと同じ)と非同期の配送だけを挟んだトランスポート。
+function inProcess(): { transport: AnalysisTransport; pipeline: AnalysisPipeline; delivered: ToWorkerMessage[] } {
+  const delivered: ToWorkerMessage[] = [];
+  let toWorker: WorkerPort["onmessage"] = null;
+  const workerPort: WorkerPort = {
+    postMessage: (m) => { setImmediate(() => transport.onmessage?.({ data: structuredClone(m) })); },
+    get onmessage() { return toWorker; },
+    set onmessage(fn) { toWorker = fn; },
+  };
+  const pipeline = attachWorkerHandler(workerPort);
+  const transport: AnalysisTransport = {
+    postMessage: (m) => { delivered.push(m); const copy = structuredClone(m); setImmediate(() => toWorker?.({ data: copy })); },
+    onmessage: null,
+  };
+  return { transport, pipeline, delivered };
+}
+
+// 注意: shakeDetection.tsのイベントIDの連番はモジュール全体で共有されるため、IDを比べるこのテストは、
+// このファイルの最初に置く(メインスレッドの解析がまだ動いていない状態で、Worker側と同じ1から始める)。
+test("Worker(別スレッド)経由の結果が、メインスレッドで直接処理した結果と、全tickで一致する", async () => {
+  const { transport } = spawnThread();
+  const client = new AnalysisClient(transport);
+  const direct = new AnalysisPipeline();
+  client.setStations(stations, false);
+  direct.setStations(stations, false);
+  let sawEvents = false, sawEstimates = false;
+  try {
+    for (let k = 0; k < 30; k++) {
+      const input = inputAt(k);
+      const viaWorker = await client.tick(input);          // 1tickずつ待つ(まとめられない)
+      const viaDirect = direct.tick(input);
+      assert.ok(viaWorker, `tick ${k}: 結果が返ること`);
+      assert.equal(ser(viaWorker), ser(viaDirect), `tick ${k}`);
+      if (viaWorker.shakeEvents.length) sawEvents = true;
+      if (viaWorker.estimates && viaWorker.estimates.size) sawEstimates = true;
+    }
+    // 同じMapのままの再呼び出しでも一致する
+    const same = valuesAt(30);
+    for (let r = 0; r < 2; r++) {
+      const input = inputAt(30, same);
+      const a = await client.tick(input);
+      const b = direct.tick(input);
+      assert.equal(ser(a), ser(b), `同じMapの再呼び出し ${r}`);
+    }
+  } finally {
+    client.terminate();
+  }
+  assert.ok(sawEvents && sawEstimates, "前提: 検知と推定が実際に動いていること");
+});
+
+test("Worker処理中に溜まったtickは、1回のメッセージにまとめられ、推定は最後の1回だけ行われる", async () => {
+  const { transport, pipeline, delivered } = inProcess();
+  const client = new AnalysisClient(transport);
+  client.setStations(stations, false);
+  let estimateCalls = 0;
+  const original = pipeline.estimator.updateAll.bind(pipeline.estimator);
+  pipeline.estimator.updateAll = (...args: Parameters<typeof original>) => { estimateCalls++; return original(...args); };
+
+  // 検知イベントが出るところまで、1tickずつ進める
+  for (let k = 0; k < 12; k++) await client.tick(inputAt(k));
+  const callsBefore = estimateCalls;
+  const sentBefore = delivered.filter((m) => m.type === "ticks").length;
+  assert.ok(callsBefore > 0, "前提: 推定が実際に動いていること");
+
+  // 処理中に4つ溜める: 1つ目は即送信、残り4つはまとめて次に送られる
+  const promises = [12, 13, 14, 15, 16].map((k) => client.tick(inputAt(k)));
+  const results = await Promise.all(promises);
+  assert.ok(results[0], "先頭(送信済みだったtick)は結果が返る");
+  assert.deepEqual(results.slice(1, 4), [null, null, null], "まとめられた途中のtickはnull");
+  assert.ok(results[4], "まとめた最後のtickに結果が返る");
+
+  const batches = delivered.filter((m): m is Extract<ToWorkerMessage, { type: "ticks" }> => m.type === "ticks").slice(sentBefore);
+  assert.deepEqual(batches.map((b) => b.items.length), [1, 4], "送信は1回目が1tick、2回目が4tick");
+  assert.equal(estimateCalls - callsBefore, 2, "推定は、1回目の1tick+2回目の最後の1tickの2回だけ(4tickまとめでも1回)");
+  client.terminate();
+});
+
+test("同じMapのままの再呼び出しは、Mapを送り直さない", async () => {
+  const { transport, delivered } = inProcess();
+  const client = new AnalysisClient(transport);
+  client.setStations(stations, false);
+  const values = valuesAt(5);
+  await client.tick(inputAt(5, values));
+  await client.tick(inputAt(5, values));
+  const ticks = delivered.filter((m) => m.type === "ticks").flatMap((m) => (m as Extract<ToWorkerMessage, { type: "ticks" }>).items);
+  assert.equal(ticks.length, 2);
+  assert.ok(ticks[0].input.values && !ticks[0].input.sameValues);
+  assert.ok(ticks[1].input.sameValues && ticks[1].input.values === undefined);
+  client.terminate();
+});
+
+test("Worker内で例外が起きたら、そのtickのPromiseがrejectされ、後続のtickは処理される", async () => {
+  const { transport, pipeline } = inProcess();
+  const client = new AnalysisClient(transport);
+  client.setStations(stations, false);
+  const realTick = pipeline.tick.bind(pipeline);
+  let failNext = true;
+  pipeline.tick = (...args: Parameters<typeof realTick>) => {
+    if (failNext) { failNext = false; throw new Error("boom"); }
+    return realTick(...args);
+  };
+  await assert.rejects(client.tick(inputAt(0)), /boom/);
+  const ok = await client.tick(inputAt(1));
+  assert.ok(ok, "例外の後も、次のtickは処理される");
+  client.terminate();
+});
+
+test("terminate後は、処理待ちのtickがrejectされる", async () => {
+  const { transport } = inProcess();
+  const client = new AnalysisClient(transport);
+  client.setStations(stations, false);
+  const p1 = client.tick(inputAt(0));
+  const p2 = client.tick(inputAt(1));
+  client.terminate();
+  await assert.rejects(p1, /terminated/);
+  await assert.rejects(p2, /terminated/);
+});
+
diff --git a/tests/areaFillCoordinator.test.ts b/tests/areaFillCoordinator.test.ts
new file mode 100644
index 0000000..0e0b189
--- /dev/null
+++ b/tests/areaFillCoordinator.test.ts
@@ -0,0 +1,82 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { AreaFillCoordinator } from "../src/app/areaFillState.js";
+
+// MapLibreのfeature-stateの代わり: areasソースの各区域の「今の色」(塗られていなければundefined)を持つ
+function fakeMap() {
+  const state = new Map<string, string | null>();
+  const calls: [string, string | null][] = [];
+  const coordinator = new AreaFillCoordinator((code: string, color: string | null) => { state.set(code, color); calls.push([code, color]); });
+  const visible = () => Object.fromEntries([...state].filter(([, c]) => c != null));
+  return { coordinator, visible, calls };
+}
+const QUAKE = new Map([["100", "#quake-a"], ["101", "#quake-b"], ["102", "#quake-c"]]);
+const EEW = new Map([["101", "#eew-b"], ["102", "#eew-c"], ["200", "#eew-d"]]);
+
+test("地震情報の塗り分けだけ: そのまま塗られ、空にすると消える", () => {
+  const { coordinator, visible } = fakeMap();
+  coordinator.setQuakeFill(QUAKE);
+  assert.deepEqual(visible(), { "100": "#quake-a", "101": "#quake-b", "102": "#quake-c" });
+  coordinator.setQuakeFill(new Map());
+  assert.deepEqual(visible(), {});
+});
+
+test("EEWの塗り分けだけ: そのまま塗られ、空にすると消える", () => {
+  const { coordinator, visible } = fakeMap();
+  coordinator.setEewFill(EEW);
+  assert.deepEqual(visible(), { "101": "#eew-b", "102": "#eew-c", "200": "#eew-d" });
+  coordinator.setEewFill(new Map());
+  assert.deepEqual(visible(), {});
+});
+
+test("両方が重なる区域は、EEWの色が優先される(従来の、EEWが後から塗って勝つ挙動と同じ)", () => {
+  const { coordinator, visible } = fakeMap();
+  coordinator.setQuakeFill(QUAKE);
+  coordinator.setEewFill(EEW);
+  assert.deepEqual(visible(), { "100": "#quake-a", "101": "#eew-b", "102": "#eew-c", "200": "#eew-d" });
+});
+
+test("【修正した不具合】EEWを隠した時(EEW側が自分の区域を消す)、重なった区域は地震情報の色に戻る", () => {
+  const { coordinator, visible } = fakeMap();
+  // EEW表示中 → 地震を選択(地震側が塗る → EEW側が空になる)。順序は、どちらが先でも同じ結果になること。
+  coordinator.setEewFill(EEW);
+  coordinator.setQuakeFill(QUAKE);
+  coordinator.setEewFill(new Map());
+  assert.deepEqual(visible(), { "100": "#quake-a", "101": "#quake-b", "102": "#quake-c" }, "重なった101・102が、消えずに地震の色になる");
+
+  const other = fakeMap();
+  other.coordinator.setEewFill(EEW);
+  other.coordinator.setEewFill(new Map());   // 先にEEWが消え
+  other.coordinator.setQuakeFill(QUAKE);     // 後から地震が塗る
+  assert.deepEqual(other.visible(), visible());
+});
+
+test("【戻る】地震の選択を解除してEEWが再び表示される時、地震側の色が消えても、EEWの色は消えない", () => {
+  const { coordinator, visible } = fakeMap();
+  coordinator.setQuakeFill(QUAKE);                 // 地震を選択中(EEWは隠れている)
+  coordinator.setQuakeFill(new Map());             // 戻る: 地震側が消える
+  coordinator.setEewFill(EEW);                     // EEWが再び塗られる
+  assert.deepEqual(visible(), { "101": "#eew-b", "102": "#eew-c", "200": "#eew-d" });
+
+  // 逆順(EEWが先に塗られ、あとから地震側が消える)でも、EEWの色を巻き込んで消さない
+  const rev = fakeMap();
+  rev.coordinator.setQuakeFill(QUAKE);
+  rev.coordinator.setEewFill(EEW);
+  rev.coordinator.setQuakeFill(new Map());
+  assert.deepEqual(rev.visible(), { "101": "#eew-b", "102": "#eew-c", "200": "#eew-d" }, "101・102のEEWの色が、地震側の消去に巻き込まれない");
+});
+
+test("色の更新(配色スキームの切り替え・続報)が反映され、無くなった区域は消える", () => {
+  const { coordinator, visible } = fakeMap();
+  coordinator.setEewFill(new Map([["1", "#a"], ["2", "#b"]]));
+  coordinator.setEewFill(new Map([["2", "#b2"], ["3", "#c"]]));
+  assert.deepEqual(visible(), { "2": "#b2", "3": "#c" });
+});
+
+test("同じ内容で再度呼ばれても、塗り直す(地図のデータが差し替わってfeature-stateが失われた場合の自己修復)", () => {
+  const { coordinator, calls } = fakeMap();
+  coordinator.setQuakeFill(QUAKE);
+  const before = calls.length;
+  coordinator.setQuakeFill(QUAKE);
+  assert.ok(calls.length >= before + QUAKE.size, "全区域をもう一度塗る");
+});
diff --git a/tests/eewVisibility.test.ts b/tests/eewVisibility.test.ts
new file mode 100644
index 0000000..0710dfd
--- /dev/null
+++ b/tests/eewVisibility.test.ts
@@ -0,0 +1,119 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { computeEewVisibility, shouldRevealIncomingEew } from "../src/app/eewVisibility.js";
+
+const active = { eventId: "a", cancelled: false, isWarnLevel: false };
+const cancelled = { eventId: "b", cancelled: true, isWarnLevel: false };
+const NONE: never[] = [];
+
+test("通常時(リアルタイムタブでEEW発表中・地震は未選択): EEWの表示はそのまま", () => {
+  const v = computeEewVisibility({ effectiveNav: "realtime", effectiveEews: [active], realtimeTabSelectedQuakeId: null, eewDetailOpen: true });
+  assert.equal(v.eewHiddenBySelection, false);
+  assert.deepEqual(v.displayedEews, [active]);
+  assert.equal(v.displayedEewDetailOpen, true);
+});
+
+test("リアルタイムタブでEEW発表中に地震を選択: EEW(円・予想震度・カード・凡例)を隠し、選んだ地震の表示を出せる", () => {
+  const eews = [active];
+  const v = computeEewVisibility({ effectiveNav: "realtime", effectiveEews: eews, realtimeTabSelectedQuakeId: "q1", eewDetailOpen: true });
+  assert.equal(v.eewHiddenBySelection, true);
+  assert.deepEqual(v.displayedEews, [], "MapCanvas・BottomDockへは空のEEW一覧を渡す");
+  assert.equal(v.displayedEewDetailOpen, false, "eewDetailOpenが残っていても、地図の震源・観測点・凡例・戻るボタンを塞がない");
+});
+
+test("選択を解除(戻る)すれば、発表中のEEWが元どおり表示される", () => {
+  const eews = [active];
+  const hidden = computeEewVisibility({ effectiveNav: "realtime", effectiveEews: eews, realtimeTabSelectedQuakeId: "q1", eewDetailOpen: true });
+  const back = computeEewVisibility({ effectiveNav: "realtime", effectiveEews: eews, realtimeTabSelectedQuakeId: null, eewDetailOpen: true });
+  assert.equal(hidden.eewHiddenBySelection, true);
+  assert.equal(back.eewHiddenBySelection, false);
+  assert.equal(back.displayedEews, eews, "元のEEW一覧(同じ配列)がそのまま渡る");
+  assert.equal(back.displayedEewDetailOpen, true);
+});
+
+test("取消済みのEEWしか無い間は、選択してもEEWの扱いは変わらない(元々表示対象外)", () => {
+  const eews = [cancelled];
+  const v = computeEewVisibility({ effectiveNav: "realtime", effectiveEews: eews, realtimeTabSelectedQuakeId: "q1", eewDetailOpen: false });
+  assert.equal(v.eewHiddenBySelection, false);
+  assert.equal(v.displayedEews, eews);
+});
+
+test("リアルタイムタブ以外(津波・天気・設定など)では、何も変わらない", () => {
+  for (const nav of ["quake", "tsunami", "weather", "alert", "settings"]) {
+    const eews = [active];
+    const v = computeEewVisibility({ effectiveNav: nav, effectiveEews: eews, realtimeTabSelectedQuakeId: "q1", eewDetailOpen: true });
+    assert.equal(v.eewHiddenBySelection, false, nav);
+    assert.equal(v.displayedEews, eews, nav);
+    assert.equal(v.displayedEewDetailOpen, true, nav);
+  }
+});
+
+test("EEWが無い時は、選択してもEEW一覧は空のまま(同じ配列を返す)", () => {
+  const v = computeEewVisibility({ effectiveNav: "realtime", effectiveEews: NONE, realtimeTabSelectedQuakeId: "q1", eewDetailOpen: false });
+  assert.equal(v.eewHiddenBySelection, false);
+  assert.equal(v.displayedEews, NONE);
+});
+
+// ---- 隠れている間に来た速報を見逃さない ----
+const sel = { selectedQuakeId: "q1", selectedQuakeOrigin: "realtime" };
+
+test("リアルタイムタブで地震を選択中に、新しい速報が来たら、選択を解除して速報を見せる", () => {
+  assert.equal(shouldRevealIncomingEew({ ...sel, existing: undefined, incoming: { cancelled: false, isWarnLevel: false } }), true);
+  assert.equal(shouldRevealIncomingEew({ ...sel, existing: null, incoming: { cancelled: false, isWarnLevel: true } }), true);
+});
+
+test("続報で、予報から警報へ切り上がった時は、選択を解除して速報を見せる", () => {
+  assert.equal(shouldRevealIncomingEew({ ...sel, existing: { isWarnLevel: false }, incoming: { cancelled: false, isWarnLevel: true } }), true);
+});
+
+test("同じ段階の続報・警報のままの続報・取消では、選択を解除しない(見ている地震を奪わない)", () => {
+  assert.equal(shouldRevealIncomingEew({ ...sel, existing: { isWarnLevel: false }, incoming: { cancelled: false, isWarnLevel: false } }), false);
+  assert.equal(shouldRevealIncomingEew({ ...sel, existing: { isWarnLevel: true }, incoming: { cancelled: false, isWarnLevel: true } }), false);
+  assert.equal(shouldRevealIncomingEew({ ...sel, existing: { isWarnLevel: true }, incoming: { cancelled: false, isWarnLevel: false } }), false);
+  assert.equal(shouldRevealIncomingEew({ ...sel, existing: undefined, incoming: { cancelled: true, isWarnLevel: false } }), false, "最初から取消の速報は見せる必要が無い");
+  assert.equal(shouldRevealIncomingEew({ ...sel, existing: { isWarnLevel: false }, incoming: { cancelled: true, isWarnLevel: true } }), false);
+});
+
+test("地震タブで選んだ地震(リアルタイムタブでは無視される選択)や、未選択の時は、何もしない", () => {
+  const incoming = { cancelled: false, isWarnLevel: true };
+  assert.equal(shouldRevealIncomingEew({ selectedQuakeId: "q1", selectedQuakeOrigin: "quake", existing: undefined, incoming }), false, "地震タブ側の選択は残す(速報後に戻れるように)");
+  assert.equal(shouldRevealIncomingEew({ selectedQuakeId: "q1", selectedQuakeOrigin: null, existing: undefined, incoming }), false);
+  assert.equal(shouldRevealIncomingEew({ selectedQuakeId: null, selectedQuakeOrigin: null, existing: undefined, incoming }), false);
+});
+
+// ---- 画面の判定(App.jsx・BottomDock.jsxの条件式を写したもの): 3つの状態で、何が見えるか ----
+// 注意: 式はApp.jsx/BottomDock.jsxから写している。そちらの式を変えた時は、ここも合わせること。
+function screen(state: { selectedQuakeId: string | null; eewDetailOpen: boolean }) {
+  const effectiveNav = "realtime";
+  const eews = [{ eventId: "a", cancelled: false, isWarnLevel: false }];
+  const v = computeEewVisibility({ effectiveNav, effectiveEews: eews, realtimeTabSelectedQuakeId: state.selectedQuakeId, eewDetailOpen: state.eewDetailOpen });
+  const hasActiveEew = v.displayedEews.some((e) => !e.cancelled);                                  // BottomDock: EEWカード
+  const showQuakeMapLayers = !v.displayedEewDetailOpen && (effectiveNav === "realtime" && state.selectedQuakeId != null); // App: 震源・観測点・震度塗り分け
+  const eewMapLegendVisible = v.displayedEewDetailOpen || v.displayedEews.some((e) => !e.cancelled); // App: 予想震度凡例
+  const quakeLegendVisible = !v.displayedEewDetailOpen && state.selectedQuakeId != null;            // App: 震度凡例
+  const backButtonVisible = !v.displayedEewDetailOpen && state.selectedQuakeId != null;             // BottomDock: 戻るボタン
+  return { eewCards: hasActiveEew, eewCircles: v.displayedEews.length > 0, eewLegend: eewMapLegendVisible, quakeMapLayers: showQuakeMapLayers, quakeLegend: quakeLegendVisible, backButton: backButtonVisible };
+}
+
+test("画面: EEW発表中(リアルタイムタブ)の、選択前→選択中→戻った後で、見えるものが入れ替わる", () => {
+  // 新規の速報で、eewDetailOpenは自動的にtrueになっている(リアルタイムタブには閉じるボタンが無く、trueのまま残る)
+  const before = screen({ selectedQuakeId: null, eewDetailOpen: true });
+  assert.deepEqual(before, { eewCards: true, eewCircles: true, eewLegend: true, quakeMapLayers: false, quakeLegend: false, backButton: false }, "選択前: EEWだけ");
+
+  const selected = screen({ selectedQuakeId: "q1", eewDetailOpen: true });
+  assert.deepEqual(selected, { eewCards: false, eewCircles: false, eewLegend: false, quakeMapLayers: true, quakeLegend: true, backButton: true },
+    "選択中: EEW(カード・PS円・予想震度・凡例)は消え、選んだ地震の震源・観測点・震度凡例・戻るボタンが出る");
+
+  const back = screen({ selectedQuakeId: null, eewDetailOpen: true });
+  assert.deepEqual(back, before, "戻った後: 発表中のEEWが元どおり");
+});
+
+test("画面: (修正前の挙動の再現) eewDetailOpenが残ったまま選択すると、EEWが残り、選んだ地震が出なかった", () => {
+  // 修正前は、computeEewVisibilityを通さず、そのままeffectiveEews・eewDetailOpenを使っていた
+  const eews = [{ eventId: "a", cancelled: false, isWarnLevel: false }];
+  const eewDetailOpen = true, selectedQuakeId = "q1";
+  const oldEewCards = eews.some((e) => !e.cancelled);
+  const oldQuakeMapLayers = !eewDetailOpen && selectedQuakeId != null;
+  const oldBackButton = !eewDetailOpen && selectedQuakeId != null;
+  assert.deepEqual({ oldEewCards, oldQuakeMapLayers, oldBackButton }, { oldEewCards: true, oldQuakeMapLayers: false, oldBackButton: false });
+});
diff --git a/tests/epicenterCache.test.ts b/tests/epicenterCache.test.ts
new file mode 100644
index 0000000..54618e7
--- /dev/null
+++ b/tests/epicenterCache.test.ts
@@ -0,0 +1,58 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { EpicenterEstimator } from "../src/engines/epicenterEstimation";
+import { makeDetections, stationGrid, T0 } from "./helpers";
+
+const stations = stationGrid(38, 142, 4, 0.3);
+const detections = makeDetections(stations, { lat: 38.1, lon: 141.9, depth: 20 }, 20, 100);
+const now0 = T0 + 10_000;
+
+function makeEvent(extra: Record<string, unknown>) {
+  return { id: 1, detections, pointCount: detections.length, ...extra };
+}
+// 推定器が内部に記録している、直近に「再計算した」時刻。再利用しただけの呼び出しでは変わらない。
+function computedAt(est: EpicenterEstimator): number | undefined {
+  return est.cache.get(1)?.computedAt;
+}
+
+test("観測点数もrevisionも同じなら再計算しない", () => {
+  const est = new EpicenterEstimator();
+  est.updateAll([makeEvent({ revision: 3 })], stations, now0);
+  assert.equal(computedAt(est), now0, "初回は計算される");
+  assert.ok(est.cache.get(1)?.result, "初回の推定結果があること");
+  est.updateAll([makeEvent({ revision: 3 })], stations, now0 + 5_000);
+  assert.equal(computedAt(est), now0);
+});
+
+test("観測点数が増えたら、即座に再計算する(従来どおり)", () => {
+  const est = new EpicenterEstimator();
+  est.updateAll([makeEvent({ revision: 3 })], stations, now0);
+  const more = makeDetections(stations, { lat: 38.1, lon: 141.9, depth: 20 }, 24, 100);
+  est.updateAll([{ id: 1, detections: more, pointCount: more.length, revision: 3 }], stations, now0 + 100);
+  assert.equal(computedAt(est), now0 + 100);
+});
+
+test("点数が同じでrevisionだけ変わった場合: 5秒の間隔内は再利用、間隔を過ぎたら再計算", () => {
+  const est = new EpicenterEstimator();
+  est.updateAll([makeEvent({ revision: 3 })], stations, now0);
+  est.updateAll([makeEvent({ revision: 4 })], stations, now0 + 4_000);
+  assert.equal(computedAt(est), now0, "5秒未満は間引く");
+  est.updateAll([makeEvent({ revision: 4 })], stations, now0 + 5_000);
+  assert.equal(computedAt(est), now0 + 5_000, "5秒以上経ったら、持ち越していたrevisionの差で再計算する");
+  est.updateAll([makeEvent({ revision: 4 })], stations, now0 + 20_000);
+  assert.equal(computedAt(est), now0 + 5_000, "revisionが同じなら再計算しない");
+});
+
+test("時刻が巻き戻っても(リプレイ)、revisionの変化を取りこぼさない", () => {
+  const est = new EpicenterEstimator();
+  est.updateAll([makeEvent({ revision: 3 })], stations, now0);
+  est.updateAll([makeEvent({ revision: 4 })], stations, now0 - 30_000);
+  assert.equal(computedAt(est), now0 - 30_000);
+});
+
+test("revisionを持たないイベント(グリッド検知)は、従来どおり観測点数だけで判定する", () => {
+  const est = new EpicenterEstimator();
+  est.updateAll([makeEvent({})], stations, now0);
+  est.updateAll([makeEvent({})], stations, now0 + 60_000);
+  assert.equal(computedAt(est), now0);
+});
diff --git a/tests/globalPass.test.ts b/tests/globalPass.test.ts
new file mode 100644
index 0000000..2911a50
--- /dev/null
+++ b/tests/globalPass.test.ts
@@ -0,0 +1,70 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { DEEP_SEARCH, estimateEpicenter } from "../src/engines/epicenterEstimation";
+import { haversineKm, makeDetections, stationGrid, type Detection } from "./helpers";
+
+// 走時テーブル未設定時のフォールバック(震源距離 / P波速度)。epicenterEstimation.tsのP_WAVE_SPEED_KM_S。
+const P_SPEED = 6.8;
+const NEAR_FIXED_WEIGHT_KM = 50; // NEAR_STATION_FIXED_WEIGHT_RADIUS_KM
+
+const stations = stationGrid(36, 138, 6, 0.5);
+const ep = { lat: 36.0, lon: 138.2, depth: 300 };
+const detections = makeDetections(stations, ep, 60, 400);
+const event = { id: 1, detections, pointCount: detections.length };
+const now = detections[detections.length - 1].detectedAt + 500;
+
+// Global Passを必ず採用させる(誤差の改善比の条件を外す)。テスト後に必ず元へ戻す。
+function withForcedGlobalPass<T>(fn: () => T): T {
+  const saved = { ...DEEP_SEARCH };
+  DEEP_SEARCH.globalPass = true;
+  DEEP_SEARCH.globalBetterRatio = 1e9;
+  try { return fn(); } finally { Object.assign(DEEP_SEARCH, saved); }
+}
+
+// 独立した検算: 結果の位置で、推定と同じ観測点の選び方・重みの到達時刻RMS(ms)を求める。
+function oracleRmsMs(r: { lat: number; lon: number; depthKm: number }, dets: Detection[]): number {
+  const first = dets.reduce((a, b) => (b.detectedAt < a.detectedAt ? b : a));
+  let firstDist = Infinity;
+  for (const d of dets) if (d !== first) firstDist = Math.min(firstDist, haversineKm(first.lat, first.lon, d.lat, d.lon));
+  const dist = (d: Detection) => haversineKm(r.lat, r.lon, d.lat, d.lon);
+  let sel = dets;
+  if (dets.length > 50) {
+    sel = [...dets].sort((a, b) => dist(a) - dist(b)).slice(0, 50);
+    if (!sel.includes(first)) sel.push(first);
+  }
+  const w = (d: Detection) => (dist(d) <= NEAR_FIXED_WEIGHT_KM ? 1 : (firstDist / Math.max(dist(d), 0.001)) ** 2);
+  const tt = (d: Detection) => (Math.hypot(dist(d), r.depthKm) / P_SPEED) * 1000;
+  let ws = 0, wt = 0;
+  for (const d of sel) { ws += w(d) * (d.detectedAt - tt(d)); wt += w(d); }
+  const origin = ws / wt;
+  let s2 = 0;
+  for (const d of sel) { const diff = d.detectedAt - tt(d) - origin; s2 += w(d) * diff * diff; }
+  return Math.sqrt(s2 / wt);
+}
+
+test("Global Pass採用時、評価指標は旧候補の値ではなく採用した候補で再計算される", () => {
+  const cur = withForcedGlobalPass(() => { DEEP_SEARCH.globalPass = false; return estimateEpicenter(event, stations, now); });
+  const forced = withForcedGlobalPass(() => estimateEpicenter(event, stations, now));
+  assert.ok(cur && forced);
+  assert.ok(forced.globalPass, "Global Passが採用されていること(前提)");
+  assert.ok(!cur.globalPass);
+  assert.notEqual(forced.depthKm, cur.depthKm, "前提: Global Passで深さが変わっていること");
+
+  // 採用した候補の位置で独立に求めたRMSと一致する(旧実装は採用前の値を引き継いでいた)。
+  const expected = oracleRmsMs(forced, detections);
+  assert.ok(Math.abs(forced.timeRmsMs - expected) < 0.5, `RMS ${forced.timeRmsMs} vs 検算 ${expected}`);
+  assert.notEqual(forced.timeRmsMs, cur.timeRmsMs);
+
+  assert.notEqual(forced.errorLevel, cur.errorLevel);
+  assert.ok(Number.isFinite(forced.errorLevel) && forced.errorLevel >= 0);
+  assert.ok(forced.azimuthalGapDeg >= 0 && forced.azimuthalGapDeg <= 360);
+  assert.equal(typeof forced.uniquenessConfirmed, "boolean");
+  assert.ok(forced.estimationPointCount > 0 && forced.estimationPointCount <= 51);
+});
+
+test("Global Passを無効にした結果は、設定を元に戻した後も再現する(設定の取りこぼしがない)", () => {
+  const before = estimateEpicenter(event, stations, now);
+  withForcedGlobalPass(() => estimateEpicenter(event, stations, now));
+  const after = estimateEpicenter(event, stations, now);
+  assert.deepEqual(after, before);
+});
diff --git a/tests/helpers.ts b/tests/helpers.ts
new file mode 100644
index 0000000..982a5a4
--- /dev/null
+++ b/tests/helpers.ts
@@ -0,0 +1,52 @@
+// テスト用の合成データ。走時テーブルは設定せず、推定側のフォールバック(震源距離/6.8km/s)を使う。
+export interface Station { id: number; lat: number; lon: number }
+export interface Detection extends Station {
+  detectedAt: number;
+  level: number;
+  intensity: number | null;
+  sWaveDetectedAt: number | null;
+}
+
+export const T0 = 1_800_000_000_000;
+
+export function haversineKm(lat1: number, lon1: number, lat2: number, lon2: number): number {
+  const r = Math.PI / 180;
+  const a = Math.sin(((lat2 - lat1) * r) / 2) ** 2
+    + Math.cos(lat1 * r) * Math.cos(lat2 * r) * Math.sin(((lon2 - lon1) * r) / 2) ** 2;
+  return 2 * 6371 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
+}
+
+// 中心(lat, lon)の周りに、間隔spacingDegで(2*half+1)^2点の観測点を並べる。
+export function stationGrid(lat: number, lon: number, half: number, spacingDeg: number): Station[] {
+  const out: Station[] = [];
+  for (let i = -half; i <= half; i++) {
+    for (let j = -half; j <= half; j++) {
+      out.push({ id: out.length + 1, lat: lat + i * spacingDeg, lon: lon + j * spacingDeg });
+    }
+  }
+  return out;
+}
+
+// 震源(ep)から各観測点へのP波到達時刻で検知を作る。ノイズは決定的な擬似乱数。
+export function makeDetections(
+  stations: Station[],
+  ep: { lat: number; lon: number; depth: number },
+  count: number,
+  noiseMs = 0,
+): Detection[] {
+  let seed = 7;
+  const rnd = () => { seed = (seed * 1664525 + 1013904223) % 4294967296; return seed / 4294967296 - 0.5; };
+  return stations
+    .map((s) => {
+      const hyp = Math.hypot(haversineKm(ep.lat, ep.lon, s.lat, s.lon), ep.depth);
+      return {
+        ...s,
+        detectedAt: Math.round(T0 + (hyp / 6.8) * 1000 + rnd() * 2 * noiseMs),
+        level: 1,
+        intensity: 1.0,
+        sWaveDetectedAt: null,
+      };
+    })
+    .sort((a, b) => a.detectedAt - b.detectedAt)
+    .slice(0, count);
+}
diff --git a/tests/hotpathEquivalence.test.ts b/tests/hotpathEquivalence.test.ts
new file mode 100644
index 0000000..2b2c054
--- /dev/null
+++ b/tests/hotpathEquivalence.test.ts
@@ -0,0 +1,138 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { calcPeakIntensity, createPeakIntensityModel } from "../src/engines/shakeTestSimulation";
+import { lookupJmaPTimeSec, lookupJmaTravelTime, tableFromJSON } from "../src/engines/jmaTravelTime";
+import { readFileSync } from "node:fs";
+
+// ---- 基準(最適化前の実装を、そのまま写したもの)。新しい実装が、全入力で1ビットも違わないことを確かめる ----
+function referencePeakIntensity(magnitudeJma: number, depthKm: number, distHypoKm: number, eventTypeCoeff = 0): number {
+  const mw = magnitudeJma - 0.171;
+  const faultLengthKm = Math.pow(10, 0.5 * mw - 1.85);
+  const shortestDistKm = Math.max(distHypoKm - faultLengthKm * 0.5, 3);
+  const logPgv600 =
+    0.58 * mw +
+    0.0038 * depthKm +
+    eventTypeCoeff -
+    Math.log10(shortestDistKm + 0.0028 * Math.pow(10, 0.5 * mw)) -
+    0.002 * shortestDistKm -
+    1.29;
+  const pgv600 = Math.pow(10, logPgv600);
+  const ARV = 1.0;
+  const pgvSurface = pgv600 * 1.31 * ARV;
+  let intensity = 2.68 + 1.72 * Math.log10(pgvSurface);
+  if (intensity > 7.5) intensity = 7.5 + (intensity - 7.5) * 0.1;
+  return intensity;
+}
+
+type Table = ReturnType<typeof tableFromJSON>;
+function referenceLookup(table: Table | null, distanceKm: number, depthKm: number) {
+  if (!table || table.distances.length === 0 || table.depths.length === 0) return null;
+  const { distances, depths, pTimesSec, sTimesSec } = table;
+  function bracket(arr: number[], v: number): [number, number, number] {
+    const n = arr.length;
+    if (n === 0) return [0, 0, 0];
+    if (v <= arr[0]) return [0, 0, 0];
+    if (v >= arr[n - 1]) return [n - 1, n - 1, 0];
+    let lo = 0, hi = n - 1;
+    while (hi - lo > 1) { const mid = (lo + hi) >> 1; if (arr[mid] <= v) lo = mid; else hi = mid; }
+    const span = arr[hi] - arr[lo];
+    const t = span > 0 ? (v - arr[lo]) / span : 0;
+    return [lo, hi, t];
+  }
+  const [xLo, xHi, tx] = bracket(distances, distanceKm);
+  const [dLo, dHi, td] = bracket(depths, depthKm);
+  const nx = distances.length;
+  const idx = (di: number, xi: number) => di * nx + xi;
+  function bilerp(arr: Float32Array): number | null {
+    const v00 = arr[idx(dLo, xLo)], v01 = arr[idx(dLo, xHi)], v10 = arr[idx(dHi, xLo)], v11 = arr[idx(dHi, xHi)];
+    if (!Number.isFinite(v00) || !Number.isFinite(v01) || !Number.isFinite(v10) || !Number.isFinite(v11)) return null;
+    const top = v00 + (v01 - v00) * tx;
+    const bottom = v10 + (v11 - v10) * tx;
+    return top + (bottom - top) * td;
+  }
+  const pTimeSec = bilerp(pTimesSec);
+  if (pTimeSec == null) return null;
+  return { pTimeSec, sTimeSec: bilerp(sTimesSec) };
+}
+
+// 決定的な擬似乱数
+function rng(seed: number) { let s = seed; return () => { s = (s * 1664525 + 1013904223) % 4294967296; return s / 4294967296; }; }
+
+// 想定震度は、べき乗と対数の往復を省いた等価な式に置き換えたので、基準(旧実装)との差は、丸めによる最後の桁だけ。
+// 許容は絶対値1e-12(実際の差は約1e-15)。
+const INTENSITY_TOLERANCE = 1e-12;
+function assertClose(actual: number, expected: number, message: string) {
+  assert.ok(Math.abs(actual - expected) <= INTENSITY_TOLERANCE, `${message}: ${actual} vs ${expected} (差 ${Math.abs(actual - expected)})`);
+}
+
+test("想定震度: createPeakIntensityModelとcalcPeakIntensityが、基準(旧実装)と許容誤差1e-12以内で一致する", () => {
+  const r = rng(1);
+  let n = 0;
+  let maxDiff = 0;
+  for (let i = 0; i < 20000; i++) {
+    const mag = 2 + r() * 7;          // M2〜9
+    const depth = r() * 700;
+    const dist = r() < 0.1 ? r() * 5 : r() * 2500; // 近距離(3km下限に掛かる)も含む
+    const coef = r() < 0.2 ? (r() - 0.5) * 0.3 : 0;
+    const expected = referencePeakIntensity(mag, depth, dist, coef);
+    assertClose(calcPeakIntensity(mag, depth, dist, coef), expected, `calcPeakIntensity M${mag} d${depth} x${dist}`);
+    assertClose(createPeakIntensityModel(mag, depth, coef)(dist), expected, `model M${mag} d${depth} x${dist}`);
+    maxDiff = Math.max(maxDiff, Math.abs(createPeakIntensityModel(mag, depth, coef)(dist) - expected));
+    n++;
+  }
+  // 境界: 7.5を超える強い揺れ(ソフトキャップ)・3km下限
+  for (const [m, d, x] of [[9, 10, 3], [8.5, 0, 0], [7.5, 5, 1], [3.5, 700, 2000]] as const) {
+    assertClose(createPeakIntensityModel(m, d)(x), referencePeakIntensity(m, d, x), `境界 M${m} d${d} x${x}`);
+  }
+  assert.equal(n, 20000);
+  assert.ok(maxDiff < 1e-13, `最大の差 ${maxDiff}(想定: 1e-15程度)`);
+});
+
+const tableJson = JSON.parse(readFileSync(new URL("../public/jma-travel-time.json", import.meta.url), "utf8"));
+const table = tableFromJSON(tableJson);
+
+test("走時表: lookupJmaTravelTime/lookupJmaPTimeSecが、基準と全入力で厳密に一致する", () => {
+  const r = rng(2);
+  for (let i = 0; i < 20000; i++) {
+    const dist = r() < 0.05 ? -r() * 10 : r() < 0.05 ? 2000 + r() * 500 : r() * 2000;   // 範囲外(下側・上側)も含む
+    const depth = r() < 0.05 ? -r() * 10 : r() < 0.05 ? 700 + r() * 100 : r() * 700;
+    const expected = referenceLookup(table, dist, depth);
+    const got = lookupJmaTravelTime(table, dist, depth);
+    assert.deepEqual(got, expected, `lookup d${dist} z${depth}`);
+    assert.equal(lookupJmaPTimeSec(table, dist, depth), expected ? expected.pTimeSec : null, `P d${dist} z${depth}`);
+  }
+  // グリッド点ちょうど・端
+  for (const d of [0, 2, 50, 200, 2000]) for (const z of [0, 2, 50, 200, 700]) {
+    assert.deepEqual(lookupJmaTravelTime(table, d, z), referenceLookup(table, d, z));
+    assert.equal(lookupJmaPTimeSec(table, d, z), referenceLookup(table, d, z)?.pTimeSec ?? null);
+  }
+});
+
+test("走時表: 目盛りが狭義単調増加でない(重複・不等間隔)表でも、基準と一致する(二分探索へのフォールバック)", () => {
+  const distances = [0, 5, 5, 20, 21, 90, 400, 400.5, 2000];   // 重複あり
+  const depths = [0, 10, 11, 300, 700];
+  const make = (n: number, seed: number) => { const r = rng(seed); return new Float32Array(n).map(() => 1 + r() * 300); };
+  const weird = { distances, depths, pTimesSec: make(distances.length * depths.length, 7), sTimesSec: make(distances.length * depths.length, 8) } as unknown as Table;
+  const r = rng(11);
+  for (let i = 0; i < 5000; i++) {
+    const dist = r() * 2100 - 20, depth = r() * 750 - 20;
+    assert.deepEqual(lookupJmaTravelTime(weird, dist, depth), referenceLookup(weird, dist, depth));
+    assert.equal(lookupJmaPTimeSec(weird, dist, depth), referenceLookup(weird, dist, depth)?.pTimeSec ?? null);
+  }
+  // 単調増加でも不等間隔(ヒント表の区画に、複数の目盛りが入る/入らない)
+  const dist2 = [0, 1, 2, 3, 100, 101, 5000];
+  const dep2 = [0, 1, 2, 3, 4, 700];
+  const tab2 = { distances: dist2, depths: dep2, pTimesSec: make(dist2.length * dep2.length, 9), sTimesSec: make(dist2.length * dep2.length, 10) } as unknown as Table;
+  for (let i = 0; i < 5000; i++) {
+    const dist = r() * 5100 - 50, depth = r() * 720 - 10;
+    assert.deepEqual(lookupJmaTravelTime(tab2, dist, depth), referenceLookup(tab2, dist, depth));
+  }
+});
+
+test("走時表: テーブルが無い・空の時はnull", () => {
+  assert.equal(lookupJmaPTimeSec(null, 10, 10), null);
+  assert.equal(lookupJmaTravelTime(null, 10, 10), null);
+  const empty = { distances: [], depths: [], pTimesSec: new Float32Array(0), sTimesSec: new Float32Array(0) };
+  assert.equal(lookupJmaPTimeSec(empty, 10, 10), null);
+  assert.equal(lookupJmaTravelTime(empty, 10, 10), null);
+});
diff --git a/tests/shakeRevision.test.ts b/tests/shakeRevision.test.ts
new file mode 100644
index 0000000..a81614b
--- /dev/null
+++ b/tests/shakeRevision.test.ts
@@ -0,0 +1,78 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { ShakeDetectionEngine } from "../src/engines/shakeDetection";
+import { computeShakeTestValues, prepareShakeTest } from "../src/engines/shakeTestSimulation";
+import { stationGrid, T0 } from "./helpers";
+
+// 検知エンジンのREVISION_INTENSITY_STEP(震度の反映幅)。
+const INTENSITY_STEP = 0.2;
+
+interface Snapshot { revision: number; pointCount: number; intensities: Map<number, number | null> }
+
+// 模擬地震を流し、毎tickの最大イベントのスナップショットを返す。
+function runSimulation(ticks: number): Snapshot[] {
+  const stations = stationGrid(38, 142, 7, 0.12);
+  const engine = new ShakeDetectionEngine();
+  engine.initialize(stations);
+  const per = prepareShakeTest({ lat: 38.0, lon: 142.0, magnitude: 6.5, depth: 20 }, stations);
+  const out: Snapshot[] = [];
+  for (let k = 0; k <= ticks; k++) {
+    const events = engine.processTick(computeShakeTestValues(per, k * 1000), T0 + k * 1000);
+    if (!events.length) continue;
+    const main = events.reduce((a, b) => (b.pointCount > a.pointCount ? b : a));
+    out.push({
+      revision: main.revision,
+      pointCount: main.pointCount,
+      intensities: new Map(main.detections.map((d: { id: number; intensity: number | null }) => [d.id, d.intensity])),
+    });
+  }
+  return out;
+}
+
+const snaps = runSimulation(40);
+
+test("前提: 模擬地震でイベントが検知される", () => {
+  assert.ok(snaps.length > 10, `イベントのあるtick数: ${snaps.length}`);
+  assert.ok(snaps[snaps.length - 1].pointCount >= 20);
+});
+
+test("revisionは数値で、減らない", () => {
+  for (let i = 0; i < snaps.length; i++) {
+    assert.equal(typeof snaps[i].revision, "number");
+    if (i > 0) assert.ok(snaps[i].revision >= snaps[i - 1].revision, `tick${i}でrevisionが減った`);
+  }
+});
+
+test("観測点が増えたtickでは、revisionも増える", () => {
+  for (let i = 1; i < snaps.length; i++) {
+    if (snaps[i].pointCount > snaps[i - 1].pointCount) assert.ok(snaps[i].revision > snaps[i - 1].revision);
+  }
+});
+
+test("観測点数が変わらなくても、震度が上がればrevisionが増える(キャッシュ停滞の再現条件)", () => {
+  const found = snaps.some((s, i) => i > 0 && s.pointCount === snaps[i - 1].pointCount && s.revision > snaps[i - 1].revision);
+  assert.ok(found, "観測点数が同じtickで、revisionだけ増えた場面があること");
+});
+
+test("revisionが変わらないtickでは、どの観測点の震度も反映済みの値から幅INTENSITY_STEP以上は上がっていない", () => {
+  let base = snaps[0];
+  for (let i = 1; i < snaps.length; i++) {
+    const s = snaps[i];
+    if (s.revision !== snaps[i - 1].revision) { base = s; continue; }
+    for (const [id, v] of s.intensities) {
+      const b = base.intensities.get(id);
+      if (v == null || b == null) continue;
+      assert.ok(v - b < INTENSITY_STEP + 1e-9, `観測点${id}: ${b} → ${v}(revision未更新のまま上昇)`);
+    }
+  }
+});
+
+test("震度が変わっていないtickでは、revisionは増えない(再計算の無駄打ちがない)", () => {
+  for (let i = 1; i < snaps.length; i++) {
+    const a = snaps[i - 1], b = snaps[i];
+    if (b.revision === a.revision) continue;
+    const changed = b.pointCount !== a.pointCount
+      || [...b.intensities].some(([id, v]) => (a.intensities.get(id) ?? null) !== v);
+    assert.ok(changed, `tick${i}: 入力が変わっていないのにrevisionが増えた`);
+  }
+});
diff --git a/tests/spatialIndex.test.ts b/tests/spatialIndex.test.ts
new file mode 100644
index 0000000..9e37fd3
--- /dev/null
+++ b/tests/spatialIndex.test.ts
@@ -0,0 +1,117 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+import { ShakeDetectionEngine } from "../src/engines/shakeDetection";
+import { buildGridIndex, type GeoPoint } from "../src/engines/spatialIndex";
+import { haversineKm } from "./helpers";
+
+function rng(seed: number) { let s = seed; return () => { s = (s * 1664525 + 1013904223) % 4294967296; return s / 4294967296; }; }
+
+// 総当たりの基準: 半径内の添字(昇順)
+function bruteWithin(points: GeoPoint[], lat: number, lon: number, radiusKm: number): number[] {
+  const out: number[] = [];
+  for (let i = 0; i < points.length; i++) if (!(haversineKm(lat, lon, points[i].lat, points[i].lon) > radiusKm)) out.push(i);
+  return out;
+}
+// インデックスの候補を、実際の距離で絞り込んだもの
+function viaIndex(points: GeoPoint[], idx: ReturnType<typeof buildGridIndex>, lat: number, lon: number, radiusKm: number): number[] {
+  return idx.query(lat, lon, radiusKm).filter((i) => !(haversineKm(lat, lon, points[i].lat, points[i].lon) > radiusKm));
+}
+
+// 実際に使われている観測点マスタ(リポジトリ内のpublic/map)
+const master: GeoPoint[] = JSON.parse(readFileSync(new URL("../public/map/stations_with_amp_revised.json", import.meta.url), "utf8"))
+  .map((s: { lat: string | number; lon: string | number }) => ({ lat: +s.lat, lon: +s.lon }));
+
+test("格子インデックス+距離での絞り込みは、総当たりと完全に同じ集合・同じ順序になる(実際の観測点マスタ)", () => {
+  assert.ok(master.length > 1000);
+  for (const [cellKm, radiusKm] of [[25, 25], [25, 100], [30, 30], [10, 80], [50, 5]] as const) {
+    const idx = buildGridIndex(master, cellKm);
+    for (let i = 0; i < master.length; i += 7) {
+      const { lat, lon } = master[i];
+      assert.deepEqual(viaIndex(master, idx, lat, lon, radiusKm), bruteWithin(master, lat, lon, radiusKm), `cell${cellKm} R${radiusKm} #${i}`);
+    }
+  }
+});
+
+test("検索点が観測点と一致しない任意の位置(日本周辺の乱数)でも、総当たりと一致する", () => {
+  const idx = buildGridIndex(master, 25);
+  const r = rng(3);
+  for (let i = 0; i < 400; i++) {
+    const lat = 20 + r() * 30, lon = 120 + r() * 35, radius = r() * 150;
+    assert.deepEqual(viaIndex(master, idx, lat, lon, radius), bruteWithin(master, lat, lon, radius));
+  }
+});
+
+test("格子で安全に扱えない場合(極・日付変更線・不正な座標)でも、総当たりと一致する", () => {
+  const r = rng(4);
+  const pts: GeoPoint[] = [];
+  for (let i = 0; i < 300; i++) pts.push({ lat: (r() - 0.5) * 178, lon: (r() - 0.5) * 360 });
+  pts.push({ lat: NaN, lon: 10 }, { lat: 10, lon: Infinity });   // 不正な座標: 総当たりでは距離NaN=除外されない
+  const idx = buildGridIndex(pts, 25);
+  for (let i = 0; i < 300; i++) {
+    const lat = (r() - 0.5) * 178, lon = (r() - 0.5) * 360, radius = r() * 3000;
+    assert.deepEqual(viaIndex(pts, idx, lat, lon, radius), bruteWithin(pts, lat, lon, radius), `#${i} (${lat},${lon}) R${radius}`);
+  }
+  for (const [lat, lon] of [[89, 0], [-89.5, 100], [10, 179.9], [10, -179.9], [0, 180]] as const) {
+    assert.deepEqual(viaIndex(pts, idx, lat, lon, 500), bruteWithin(pts, lat, lon, 500), `edge (${lat},${lon})`);
+  }
+});
+
+// 基準: ShakeDetectionEngine.initializeの、近傍探索の元の実装(総当たり)をそのまま写したもの。
+// 距離の式も、エンジン内のhaversineKm(shakeDetection.ts)と同じ書き方にする(式の書き方が違うと、最後の桁がずれる)。
+function engineHaversineKm(lat1: number, lon1: number, lat2: number, lon2: number): number {
+  const R = 6371;
+  const dLat = (lat2 - lat1) * Math.PI / 180;
+  const dLon = (lon2 - lon1) * Math.PI / 180;
+  const a =
+    Math.sin(dLat / 2) ** 2 +
+    Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) * Math.sin(dLon / 2) ** 2;
+  return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
+}
+function referenceNeighbors(stations: { id: number; lat: number; lon: number }[], neighborRadiusKm: number, maxNeighbors: number, sparseMin: number, sparseRadiusKm: number, sparseEnabled: boolean) {
+  const out = new Map<number, { nearPoints: { id: number; distanceKm: number }[]; extPoints: { id: number; distanceKm: number }[] }>();
+  for (const s of stations) {
+    const candidates = [];
+    for (const other of stations) {
+      if (other.id === s.id) continue;
+      const dist = engineHaversineKm(s.lat, s.lon, other.lat, other.lon);
+      if (dist > neighborRadiusKm) continue;
+      candidates.push({ id: other.id, distanceKm: dist });
+    }
+    candidates.sort((a, b) => a.distanceKm - b.distanceKm);
+    const nearPoints = candidates.slice(0, maxNeighbors);
+    let extPoints: { id: number; distanceKm: number }[] = [];
+    if (sparseEnabled && nearPoints.length < sparseMin) {
+      const ext = [];
+      for (const other of stations) {
+        if (other.id === s.id) continue;
+        const dist = engineHaversineKm(s.lat, s.lon, other.lat, other.lon);
+        if (dist > sparseRadiusKm) continue;
+        ext.push({ id: other.id, distanceKm: dist });
+      }
+      ext.sort((a, b) => a.distanceKm - b.distanceKm);
+      extPoints = ext.slice(0, maxNeighbors);
+    }
+    out.set(s.id, { nearPoints, extPoints });
+  }
+  return out;
+}
+
+test("ShakeDetectionEngine.initializeの近傍リスト(近傍・疎な観測点の拡張近傍)が、元の総当たりの実装と完全に一致する", () => {
+  // 実際のマスタに、わざと同じ座標の観測点(距離が同じ=並び順が結果に影響する)も混ぜる
+  const stations = master.slice(0, 1500).map((p, i) => ({ id: i + 1, lat: p.lat, lon: p.lon }));
+  for (let i = 0; i < 40; i++) stations.push({ id: 2000 + i, lat: stations[i * 3].lat, lon: stations[i * 3].lon });
+  const engine = new ShakeDetectionEngine();
+  engine.initialize(stations);
+  const p = engine.params;
+  const expected = referenceNeighbors(stations, p.neighborRadiusKm, p.maxNeighbors, p.sparseNeighborMin, p.sparseNeighborRadiusKm, p.sparseNeighborEnabled);
+  let withExt = 0;
+  for (const s of stations) {
+    const point = engine.points.get(s.id);
+    const e = expected.get(s.id)!;
+    assert.deepEqual(point.nearPoints, e.nearPoints, `nearPoints #${s.id}`);
+    assert.deepEqual(point.extPoints, e.extPoints, `extPoints #${s.id}`);
+    if (e.extPoints.length) withExt++;
+  }
+  assert.ok(withExt > 0, "前提: 疎な観測点の拡張近傍が実際に使われていること");
+});
diff --git a/tests/stationNoise.test.ts b/tests/stationNoise.test.ts
new file mode 100644
index 0000000..cd86f8f
--- /dev/null
+++ b/tests/stationNoise.test.ts
@@ -0,0 +1,92 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { ShakeDetectionEngine } from "../src/engines/shakeDetection";
+import { stationGrid, T0 } from "./helpers";
+
+// 64観測点(minStations=50以上)。観測値は実データと同じ0.1刻み。NOISY_ID(1点)だけが、平常時に0.1ずつ揺れ続ける。
+const stations = stationGrid(36, 138, 4, 0.4).slice(0, 64);
+const NOISY_ID = stations[10].id;
+const WARMUP = 180;
+// ノイズの多い観測点は1tickおきに「反応中」になり、その間は統計から除外される(標本が半分になる)ので、
+// 標本がWARMUPに届くまで十分長く流す。
+const RUN = WARMUP * 3;
+
+function makeEngine(noise: Record<string, unknown>) {
+  const engine = new ShakeDetectionEngine({ stationNoise: noise });
+  engine.initialize(stations);
+  return engine;
+}
+function quietTick(engine: ShakeDetectionEngine, k: number) {
+  const values = new Map<number, number>();
+  for (const s of stations) values.set(s.id, s.id === NOISY_ID ? (k % 2 ? -2.9 : -3.0) : -3.0);
+  return engine.processTick(values, T0 + k * 1000);
+}
+function stat(engine: ShakeDetectionEngine, id: number) {
+  return engine.getStationNoiseStats().stations.find((s: { id: number }) => s.id === id);
+}
+
+test("既定では無効で、統計は集めるが倍率は常に1", () => {
+  const engine = new ShakeDetectionEngine();
+  engine.initialize(stations);
+  for (let k = 0; k < RUN; k++) quietTick(engine, k);
+  const stats = engine.getStationNoiseStats();
+  assert.equal(stats.enabled, false);
+  assert.ok(stats.stations.every((s: { scale: number }) => s.scale === 1));
+  assert.ok(stat(engine, NOISY_ID).meanAbsDiff > 0.05, "ノイズ統計は収集されている");
+});
+
+test("有効にすると、常にノイズの多い観測点だけ倍率が上がり、上限を超えない", () => {
+  const engine = makeEngine({ enabled: true });
+  for (let k = 0; k < RUN; k++) quietTick(engine, k);
+  const noisy = stat(engine, NOISY_ID);
+  assert.ok(noisy.scale > 1 && noisy.scale <= 2, `noisy scale=${noisy.scale}`);
+  const quiet = stations.filter((s) => s.id !== NOISY_ID).map((s) => stat(engine, s.id));
+  assert.ok(quiet.every((s: { scale: number }) => s.scale === 1), "静かな観測点は倍率1のまま(下限minScale=1)");
+});
+
+test("標本がwarmupSamples未満の間は、倍率は1のまま", () => {
+  const engine = makeEngine({ enabled: true });
+  for (let k = 0; k < WARMUP - 20; k++) quietTick(engine, k);
+  assert.equal(stat(engine, NOISY_ID).scale, 1);
+});
+
+test("観測点の数がminStations未満なら、倍率は1のまま(中央値が信用できない)", () => {
+  const engine = new ShakeDetectionEngine({ stationNoise: { enabled: true } });
+  engine.initialize(stations.slice(0, 20));
+  for (let k = 0; k < RUN; k++) {
+    const values = new Map<number, number>();
+    for (const s of stations.slice(0, 20)) values.set(s.id, s.id === NOISY_ID ? (k % 2 ? -2.9 : -3.0) : -3.0);
+    engine.processTick(values, T0 + k * 1000);
+  }
+  assert.ok(engine.getStationNoiseStats().stations.every((s: { scale: number }) => s.scale === 1));
+});
+
+test("倍率は上昇量を割る形で、しきい値判定に反映される", () => {
+  const engine = makeEngine({ enabled: true });
+  for (let k = 0; k < RUN; k++) quietTick(engine, k);
+  const scale = stat(engine, NOISY_ID).scale;
+  assert.ok(scale > 1, "前提: この観測点の倍率が1より大きいこと");
+  const point = engine.points.get(NOISY_ID);
+  const before = point.latestIntensity;
+  const values = new Map<number, number>();
+  for (const s of stations) values.set(s.id, s.id === NOISY_ID ? before + 0.6 : -3.0);
+  engine.processTick(values, T0 + 1_000_000);
+  assert.ok(Math.abs(point.intensityDiff - 0.6 / scale) < 1e-9, `intensityDiff=${point.intensityDiff}`);
+});
+
+test("データ源の切り替え(resetForSourceChange)で、ノイズ統計が破棄される", () => {
+  const engine = makeEngine({ enabled: true });
+  for (let k = 0; k < RUN; k++) quietTick(engine, k);
+  assert.ok(stat(engine, NOISY_ID).scale > 1, "前提: リセット前は倍率が上がっている");
+  engine.resetForSourceChange(T0, 0);
+  const s = stat(engine, NOISY_ID);
+  assert.equal(s.samples, 0);
+  assert.equal(s.scale, 1);
+  assert.equal(engine.getStationNoiseStats().median, null);
+});
+
+test("stationNoiseの一部の項目だけ渡しても、残りは既定値で補われる", () => {
+  const engine = makeEngine({ enabled: true });
+  assert.equal(engine.params.stationNoise.maxScale, 2);
+  assert.equal(engine.params.stationNoise.warmupSamples, WARMUP);
+});
diff --git a/tools/analysisNodeWorker.mts b/tools/analysisNodeWorker.mts
